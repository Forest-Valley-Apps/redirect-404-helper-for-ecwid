{
    "name": "fv/redirect-404-helper-for-ecwid",
    "description": "Ecwid-aware 404 logging and redirects for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13.5",
        "wp-coding-standards/wpcs": "^3.4",
        "phpcompatibility/phpcompatibility-wp": "^2.1.8",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpunit/phpunit": "^9.6.38",
        "brain/monkey": "^2.7",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "FV\\WPEcwidRedirectHelper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FV\\WPEcwidRedirectHelper\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "phpunit": "phpunit",
        "phpunit:integration": "phpunit -c phpunit-integration.xml.dist",
        "test": [
            "@phpcs",
            "@phpunit"
        ]
    }
}
